# Copy to .env and fill in. .env is git-ignored. Used by docker compose AND by the Vite app (bolt straight from the browser).
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Optional
NEO4J_VERSION=2026.10.2
# Scenario 7 (needs: docker compose --profile batfish up -d)
BATFISH_SIDECAR_URL=http://127.0.0.1:5005
# Host ports (change if 7687/7474 are taken on your machine; then also change NEO4J_URI)
# NEO4J_BOLT_PORT=7687
# NEO4J_HTTP_PORT=7474
